import { describe, it, expect, vi, beforeEach } from "vitest";
import { submitApplicationFn } from "@/components/ambassador/apply/actions";
import { sendContactEmailFn } from "@/frontend/pages/contact";
import { submitSponsorApplicationFn } from "@/features/sponsors/actions";
import { submitHostEventEmailFn } from "@/features/host/actions";
import { supabase } from "@/integrations/supabase/client";

// Mock Supabase
vi.mock("@/integrations/supabase/client", () => {
  const insertMock = vi.fn().mockResolvedValue({ data: { id: "mock-id" }, error: null });
  const selectMock = vi.fn().mockReturnValue({
    single: vi.fn().mockResolvedValue({ data: { id: "mock-org" }, error: null }),
  });
  const upsertMock = vi.fn().mockReturnValue({ select: selectMock });

  return {
    supabase: {
      from: vi.fn().mockReturnValue({
        insert: insertMock,
        upsert: upsertMock,
      }),
      storage: {
        from: vi.fn().mockReturnValue({
          upload: vi.fn().mockResolvedValue({ data: {}, error: null }),
          getPublicUrl: vi.fn().mockReturnValue({ data: { publicUrl: "http://mock.com/file" } }),
        }),
      },
    },
  };
});

// Mock Resend
const sendMock = vi.fn();
vi.mock("resend", () => {
  return {
    Resend: vi.fn().mockImplementation(() => {
      return {
        emails: {
          send: sendMock,
        },
      };
    }),
  };
});

describe("Email Security & Validation Tests", () => {
  beforeEach(() => {
    vi.clearAllMocks();
    process.env.RESEND_API_KEY = "re_test_key";
  });

  it("Contact Form - Valid submission", async () => {
    sendMock.mockResolvedValueOnce({ data: { id: "email-id" }, error: null });

    const result = await sendContactEmailFn({
      data: {
        name: "Test User",
        email: "test@example.com",
        message: "Hello",
      },
    });

    expect(result.success).toBe(true);
    expect(sendMock).toHaveBeenCalledTimes(1);
  });

  it("Ambassador Form - HTML Injection is escaped", async () => {
    sendMock.mockResolvedValueOnce({ data: { id: "email-id" }, error: null });

    const maliciousName = '<script>alert("xss")</script>';

    await submitApplicationFn({
      data: {
        full_name: maliciousName,
        email: "hacker@example.com",
        phone: "1234567890",
        dob: "2000-01-01",
        gender: "Male",
        nationality: "Indian",
        address: "123",
        city: "City",
        state: "State",
        pincode: "123456",
        education: {
          university: "U",
          major: "M",
          degree: "D",
          yearOfStudy: "1",
          expectedGraduation: "2025",
        },
        skills: ["JS"],
        experience: { previousAmbassador: "None", techCommunities: "None", hackathons: "None" },
        questions: { whyOrigoHOSTs: "Testing", strategy: "Test" },
        social: { github: "", linkedin: "", twitter: "", portfolio: "" },
      },
    });

    // Check if the HTML sent to Resend contains the escaped string, not the raw script tag
    const sendArgs = sendMock.mock.calls[0][0];
    expect(sendArgs.html).toContain("&lt;script&gt;alert(&quot;xss&quot;)&lt;/script&gt;");
    expect(sendArgs.html).not.toContain("<script>");
  });

  it("Sponsor Form - Email Failure Simulation (DB should still save)", async () => {
    // DB succeeds

    // Resend fails
    sendMock.mockResolvedValueOnce({ data: null, error: { message: "Rate limit exceeded" } });

    const result = await submitSponsorApplicationFn({
      data: {
        company_name: "Tech Inc",
        website: "https://example.com",
        contact_name: "John",
        contact_designation: "CEO",
        contact_email: "john@example.com",
        contact_phone: "1231231234",
      },
    });

    expect(result.success).toBe(true);
    expect(result.warning).toBeDefined(); // Warning returned!
    expect(supabase.from).toHaveBeenCalledWith("sponsor_applications");
  });

  it("Host Event - Reject Missing Fields", async () => {
    // Missing required fields
    await expect(
      submitHostEventEmailFn({
        data: {
          organizationName: "Org",
        } as any,
      }),
    ).rejects.toThrow(); // Zod validation fails
  });
});
