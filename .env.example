# ==============================================================================
# OrigoHOST Platform Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Operational Data Platform Credentials (Client & Server)
# ------------------------------------------------------------------------------
# Public Supabase URL (Browser Safe)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"

# Public Anon Key (Browser Safe - Subject to Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Privileged Service Role Key (SERVER ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Direct PostgreSQL Connection String for Database Migrations & Prisma/ORM
DATABASE_URL="postgresql://postgres:your-password@db.your-supabase-project.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Payload CMS Configuration
# ------------------------------------------------------------------------------
PAYLOAD_SECRET="your-payload-secret-key-min-32-chars"

# ------------------------------------------------------------------------------
# 3. Application Domain & Base URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
