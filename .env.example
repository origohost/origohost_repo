# ─────────────────────────────────────────────────────────────────────────────
# OrigoHOST Environment Configuration Template
# DO NOT ADD SECRETS TO THIS FILE. 
# Copy to .env and populate with real values.
# ─────────────────────────────────────────────────────────────────────────────

# Application
VITE_APP_NAME="OrigoHOST"
VITE_APP_URL="http://localhost:8080"
VITE_SITE_URL="https://www.origohost.in"


# Supabase (Public/Browser)
VITE_SUPABASE_URL="your_supabase_url_here"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id_here"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"

# Supabase (Server/Admin - DO NOT EXPOSE TO BROWSER)
SUPABASE_URL="your_supabase_url_here"
SUPABASE_PROJECT_ID="your_supabase_project_id_here"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"
SUPABASE_SECRET_KEY="your_supabase_service_role_key_here"

# Third-Party Integrations
RESEND_API_KEY="your_resend_api_key_here"
VITE_LOGO_DEV_TOKEN="your_logo_dev_token_here"
VITE_LOVABLE_CONNECTOR_LOGO_DEV_API_KEY="your_lovable_logo_dev_api_key_here"
